# Runtime libs rebuilt from upstream sources against our OpenSSL.
# Versions and configure flags follow the customer's runtime bundle (checked with readelf).
# Sourced by build_runtime_deps.sh and check_and_package.sh.

PROFILE_NAME=openssl3-fips

ZLIB_VERSION=1.2.11
ZLIB_SHA256=c3e5e9fdd5004dcb542feda5ee4f0ff0744628baf8ed2dd5d66f8ca1197cb1a1
CARES_VERSION=1.31.0
CARES_SHA256=0167a33dba96ca8de29f3f598b1e6cabe531799269fd63d0153aa0e6f5efeabd
KRB5_VERSION=1.20.2
KRB5_SHA256=7d8d687d42aed350c2525cb69a4fc3aa791694da6761dccc1c42c2ee7796b5dd
SASL_VERSION=2.1.28
SASL_SHA256=7ccfc6abd01ed67c1a0924b353e526f1b766b21f42d4562ee635a8ebfc5bb38c
OPENLDAP_VERSION=2.4.59
OPENLDAP_SHA256=99f37d6747d88206c470067eda624d5e48c1011e943ec0ab217bae8712e22f34
CURL_VERSION=8.22.0
CURL_SHA256=f7ef3ae8a22e521f289803fe93543eb64c329b58aa73a9e224dfd915a2a5f4f7

# mongod NEEDED must match the customer's current mongod 8.0 (from their ldd)
EXPECTED_NEEDED="ld-linux-x86-64.so.2 libc.so.6 libcrypto.so.3 libcurl.so.4 libdl.so.2 libgcc_s.so.1 libgssapi_krb5.so.2 liblber-2.4.so.2 libldap-2.4.so.2 libm.so.6 libpthread.so.0 libresolv.so.2 librt.so.1 libsasl2.so.3 libssl.so.3"
# how many of them come from the runtime-libs layout (the rest is glibc/libgcc from the OS)
EXPECTED_LAYOUT_LIBS=13
# newest glibc symbol mongod may need (RHEL 8 baseline)
MAX_GLIBC=2.28
